{
  "name": "nukkad",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@nukkad/core --filter=@nukkad/api --filter=@nukkad/web",
    "dev:api": "turbo run dev --filter=@nukkad/core --filter=@nukkad/api",
    "dev:web": "turbo run dev --filter=@nukkad/web",
    "dev:mobile": "pnpm --filter @nukkad/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @nukkad/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @nukkad/api run seed"
  },
  "devDependencies": {
    "turbo": "^2.10.3"
  }
}
