{
  "expo": {
    "name": "Nukkad",
    "slug": "nukkad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nukkad",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sailendradarbha.nukkad",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sailendradarbha.nukkad",
      "adaptiveIcon": {
        "backgroundColor": "#E8472B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nukkad uses your location to find the store nearest to you and to deliver to the right place."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
