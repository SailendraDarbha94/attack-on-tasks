{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep the incremental-build state inside dist so nest's deleteOutDir
    // wipes it together with the output. A stale tsbuildinfo next to a
    // deleted dist makes tsc skip emit entirely (a silently empty build).
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
