# Postgres. Locally this is the Homebrew server; in production, Supabase.
# DATABASE_URL: pooled connection (Supabase port 6543) for runtime queries.
# DIRECT_URL:   direct/session connection (port 5432), used by prisma migrate.
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/nukkad_dev
DIRECT_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/nukkad_dev

PORT=4000

# Demo sign-in: one-tap accounts and password-less sign-up, for development
# only. The API refuses to start with this on when NODE_ENV=production.
DEV_AUTH=1

# Signs the demo sign-in's tokens (HS256). Any long random string.
# Leave unset in production so that only Supabase tokens are accepted.
AUTH_JWT_SECRET=

# Supabase project URL. When set, tokens issued by Supabase Auth are accepted,
# verified against the project's public keys.
# SUPABASE_URL=
